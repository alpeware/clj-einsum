;; ==============================================================================
;; catalog/registry.edn — Master Machine-Readable Registry of Verified Experiments
;; ==============================================================================
;; The permanent mapping of minted eNN identifiers to research pods, status,
;; RFC-style headers, hardware targets, Generation Lineage, and Ali Ghodsi's 4
;; Recursive Self-Improvement (RSI) gates.
;; Paths are ephemeral; IDs in this registry are immutable.
;; Papers cite IDs directly from this registry.
;; ==============================================================================

{:version 2

 :meta-research-loop
 {:description "Closed-loop research apparatus translating literature hypotheses into verified device executables."
  :stages
  [{:stage :hypothesis :desc "Extract falsifiable architectural proposal from literature DAG or prior generation"}
   {:stage :reification :desc "Express proposal purely as declarative einsum Hiccup AST ([:= head & body-terms])"}
   {:stage :compilation :desc "Compile AST into StableHLO MLIR and execute natively on PJRT accelerator"}
   {:stage :critique :desc "Adversarial review against differential reference interpreter and physical silicon baselines"}
   {:stage :catalog-commit :desc "Record immutable results, specs, and summary CSVs in catalog and registry.edn"}]}

 :rsi-gates
 {:gate-1-resource
  {:title "Gate 1: Resource Efficiency (C_{n+1} ≪ C_n)"
   :criterion "The next generation requires materially (super-linearly) fewer resources/memory/compute than predecessor."
   :metrics [:vram-bytes-allocated :parameter-deduplication-ratio :flops-per-deduction]}

  :gate-2-time
  {:title "Gate 2: Time Efficiency (T_{n+1} ≪ T_n)"
   :criterion "The next generation trains, adapts, or deliberates in materially less latency."
   :metrics [:dispatch-latency-us :prefill-elimination-ms :turn-latency-ms]}

  :gate-3-capability
  {:title "Gate 3: Capability Improvement (A_{n+1} > A_n)"
   :criterion "The next generation demonstrates strictly higher task accuracy, safety, or invariant preservation."
   :metrics [:cloze-accuracy :semantic-parity-rate :rbac-violation-count :self-correction-lift]}

  :gate-4-repeatability
  {:title "Gate 4: Repeatability & Closed-Loop Autonomy (G_n → G_{n+1})"
   :criterion "The improvement cycle operates autonomously without degradation over extended horizons."
   :metrics [:horizon-length :in-graph-stability-rate :multi-turn-drift]}}

