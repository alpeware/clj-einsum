{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        metosin/malli {:mvn/version "0.16.4"}
        org.babashka/sci {:mvn/version "0.9.44"}}
 :aliases
 {:run
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :tools
  {:extra-paths ["."]}
  :experiments
  {:extra-paths ["." "catalog" "proposals"]}
  :gpt2
  {:extra-paths ["."]
   :main-opts ["-m" "tools.gpt2-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :smollm
  {:extra-paths ["."]
   :main-opts ["-m" "tools.smollm-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :gemma
  {:extra-paths ["."]
   :main-opts ["-m" "tools.gemma2-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :gemma2
  {:extra-paths ["."]
   :main-opts ["-m" "tools.gemma2-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :gemma3
  {:extra-paths ["."]
   :main-opts ["-m" "tools.gemma3-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :gemma4
  {:extra-paths ["."]
   :main-opts ["-m" "tools.gemma4-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :gemma4-agent
  {:extra-paths ["."]
   :main-opts ["-m" "tools.gemma4-agent"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :gemma4-relational
  {:extra-paths ["."]
   :main-opts ["-m" "tools.eval-gemma4-webnlg-relational"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx16g"]}
  :e22
  {:extra-paths ["."]
   :main-opts ["-i" "catalog/gate4-recursion/e22-ingraph-dispatch/run.clj" "-m" "tools.e22-kb-dispatch"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :e23
  {:extra-paths ["."]
   :main-opts ["-i" "catalog/gate4-recursion/e23-state-reduce/run.clj" "-m" "tools.e23-reduce"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :e24
  {:extra-paths ["."]
   :main-opts ["-i" "catalog/gate1-compression/e24-prefix-cache-handover/run.clj" "-m" "tools.e24-vram-c2c"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :benchmark
  {:extra-paths ["."]
   :main-opts ["-m" "tools.benchmark"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx8g"]}
  :download-hf
  {:extra-paths ["."]
   :main-opts ["-m" "tools.download-hf"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :fetch-pjrt
  {:extra-paths ["."]
   :main-opts ["-m" "tools.fetch-pjrt"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :quantize
  {:extra-paths ["."]
   :main-opts ["-m" "tools.quantize"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :repl
  {:jvm-opts ["-Dclojure.server.repl={:port 5555 :accept clojure.core.server/repl}"
              "--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :test
  {:extra-paths ["test" "."]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.01.19"}
                  org.clojure/data.json {:mvn/version "2.5.0"}
                  org.clojure/test.check {:mvn/version "1.1.1"}}
   :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "tools"]}
  :format
  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.1"}}
   :main-opts ["-m" "cljfmt.main" "fix" "src" "test" "tools"]}}}
