{:paths ["src" "."]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        metosin/malli {:mvn/version "0.16.4"}
        org.babashka/sci {:mvn/version "0.9.44"}}
 :aliases
 {:run
  {:jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :gpt2
  {:main-opts ["-m" "scripts.gpt2-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :smollm
  {:main-opts ["-m" "scripts.smollm-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :gemma
  {:main-opts ["-m" "scripts.gemma2-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :gemma2
  {:main-opts ["-m" "scripts.gemma2-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :gemma3
  {:main-opts ["-m" "scripts.gemma3-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :gemma4
  {:main-opts ["-m" "scripts.gemma4-inference"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :gemma4-agent
  {:main-opts ["-m" "scripts.gemma4-agent"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :gemma4-relational
  {:main-opts ["-m" "scripts.eval-gemma4-webnlg-relational"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx16g"]}
  :e22
  {:main-opts ["-m" "scripts.e22-kb-dispatch"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :e23
  {:main-opts ["-m" "scripts.e23-reduce"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :e24
  {:main-opts ["-m" "scripts.e24-vram-c2c"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :benchmark
  {:main-opts ["-m" "scripts.benchmark"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx8g"]}
  :download-hf
  {:main-opts ["-m" "scripts.download-hf"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :fetch-pjrt
  {:main-opts ["-m" "scripts.fetch-pjrt-binaries"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :quantize
  {:main-opts ["-m" "scripts.quantize"]
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx12g"]}
  :repl
  {:jvm-opts ["-Dclojure.server.repl={:port 5555 :accept clojure.core.server/repl}"
              "--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :test
  {:extra-paths ["test"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}
   :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx4g"]}
  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.01.19"}
                  org.clojure/data.json {:mvn/version "2.5.0"}
                  org.clojure/test.check {:mvn/version "1.1.1"}}
   :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "scripts"]}
  :format
  {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.1"}}
   :main-opts ["-m" "cljfmt.main" "fix" "src" "test" "scripts"]}}}
